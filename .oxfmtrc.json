{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "avoid",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "jsxSingleQuote": true,
  "printWidth": 80,
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "bun.lock",
    ".next",
    ".open-next",
    ".wrangler",
    "infra/.terraform",
    "public/dropper.mjs",
    "cloudflare-env.d.ts",
    "next-env.d.ts",
    "tools/oxlint/anti-slop",
    ".agents",
    ".claude",
    ".cursor"
  ]
}
