# S3-compatible storage. For Cloudflare R2:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_REGION=auto
# For AWS S3:
#   S3_ENDPOINT=https://s3.<region>.amazonaws.com
#   S3_REGION=<region>
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bearer token the CLI uses to upload/delete builds. Generate with: openssl rand -hex 32
UPLOAD_TOKEN=

# Secret used to sign install links and the access cookie. Generate with: openssl rand -hex 32
SIGNING_SECRET=

# Optional. When set, the site asks for this password before showing builds.
ACCESS_PASSWORD=
