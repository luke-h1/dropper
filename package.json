{
  "name": "dropper",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "build:cli": "bun build cli/dropper.ts --target node --outfile public/dropper.mjs --banner '#!/usr/bin/env node'",
    "check:cli": "bun run build:cli && git diff --exit-code public/dropper.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format:check": "oxfmt --check",
    "format:fix": "oxfmt",
    "ts:check": "next typegen && tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=20.17"
  },
  "packageManager": "bun@1.3.14"
}
